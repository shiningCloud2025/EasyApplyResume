@startuml
!pragma layout smetana
title 图4 控制层详细实现类图（Controller）
top to bottom direction
hide circle

skinparam monochrome true
skinparam shadowing false
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam defaultFontName SimSun
skinparam classFontName SimSun
skinparam classAttributeFontName SimSun
skinparam classBackgroundColor white
skinparam classBorderColor black
skinparam minClassWidth 220
skinparam ranksep 85
skinparam nodesep 55

class "BaseResult\n统一响应类" as BaseResult {
  +code: Integer
  +message: String
  +data: T
  +ok()
  +ok(T)
}

class "UserSaveResumeController\n用户简历控制层" as UserSaveResumeController {
  +getUserSaveResumeInfoByUserId()
  +saveUserSaveResumeInfo()
  +saveUserSaveResumeInfoFirst()
  +saveUserSaveResumeInfoFirstByImport()
  +assistReactCodeByAI()
  +scoreByModel()
}
class "UserAuthController\n用户认证控制层" as UserAuthController {
  +formalLogin()
  +phoneLogin()
  +emailLogin()
  +formalRegister()
  +logout()
  +getUserInfo()
}
class "AdminRecruitPositionController\n招聘岗位控制层" as AdminRecruitPositionController {
  +addRecruitPosition()
  +updateRecruitPosition()
  +deleteRecruitPosition()
  +queryRecruitPosition()
  +queryRecruitPositionPage()
}

class "UserCollectionsController\n用户收藏控制层" as UserCollectionsController {
  +isUserCollectResumeTemplate()
  +saveResumeTemplateByUserId()
  +getUserCollectResumeTemplate()
}
class "UserSendResumeToHrController\n简历投递控制层" as UserSendResumeToHrController {
  +sendResumeToHr()
}
class "AdminAuthController\n管理员认证控制层" as AdminAuthController {
  +formalLogin()
  +phoneLogin()
  +emailLogin()
  +getAdminInfo()
}

interface "UserSaveResumeService" as UserSaveResumeService
interface "UserAuthService" as UserAuthService
interface "RecruitPositionService" as RecruitPositionService
interface "UserCollectionsService" as UserCollectionsService
interface "UserSendResumeToHrService" as UserSendResumeToHrService
interface "AdminAuthService" as AdminAuthService

class "简历相关参数对象\n-UserSaveResumeQuery\n-UserSaveResumeInfoVO\n-ResumeTemplateInfoVO\n-MultipartFile" as ResumeDtoGroup
class "用户认证参数对象\n-FormalLoginForm\n-PhoneLoginForm\n-EmailLoginForm\n-FormalRegisterForm\n-SecurityUser" as UserAuthDtoGroup
class "招聘岗位参数对象\n-RecruitPositionForm\n-RecruitPositionQuery\n-RecruitPositionInfoVO\n-RecruitPositionPageVO" as RecruitDtoGroup
class "收藏/投递参数对象\n-UserSendResumeToHrForm\n-ResumeTemplateInfoVO" as CollectionSendDtoGroup
class "管理员认证参数对象\n-AdminFormalLoginForm\n-AdminPhoneLoginForm\n-EmailLoginForm\n-SecurityUser" as AdminAuthDtoGroup

' 控制器 -> 服务
UserSaveResumeController --> UserSaveResumeService
UserAuthController --> UserAuthService
AdminRecruitPositionController --> RecruitPositionService
UserCollectionsController --> UserCollectionsService
UserSendResumeToHrController --> UserSendResumeToHrService
AdminAuthController --> AdminAuthService

' 控制器 -> 参数对象
UserSaveResumeController ..> ResumeDtoGroup
UserAuthController ..> UserAuthDtoGroup
AdminRecruitPositionController ..> RecruitDtoGroup
UserCollectionsController ..> CollectionSendDtoGroup
UserSendResumeToHrController ..> CollectionSendDtoGroup
AdminAuthController ..> AdminAuthDtoGroup

' 控制器统一响应
UserSaveResumeController ..> BaseResult
UserCollectionsController ..> BaseResult
UserSendResumeToHrController ..> BaseResult
UserAuthController ..> BaseResult
AdminAuthController ..> BaseResult
AdminRecruitPositionController ..> BaseResult

' 3x2 网格布局
UserSaveResumeController -[hidden]right-> UserAuthController
UserAuthController -[hidden]right-> AdminRecruitPositionController
UserCollectionsController -[hidden]right-> UserSendResumeToHrController
UserSendResumeToHrController -[hidden]right-> AdminAuthController
UserSaveResumeController -[hidden]down-> UserCollectionsController
UserAuthController -[hidden]down-> UserSendResumeToHrController
AdminRecruitPositionController -[hidden]down-> AdminAuthController

UserSaveResumeService -[hidden]right-> UserAuthService
UserAuthService -[hidden]right-> RecruitPositionService
UserCollectionsService -[hidden]right-> UserSendResumeToHrService
UserSendResumeToHrService -[hidden]right-> AdminAuthService
UserSaveResumeService -[hidden]down-> UserCollectionsService
UserAuthService -[hidden]down-> UserSendResumeToHrService
RecruitPositionService -[hidden]down-> AdminAuthService

ResumeDtoGroup -[hidden]right-> UserAuthDtoGroup
UserAuthDtoGroup -[hidden]right-> RecruitDtoGroup
CollectionSendDtoGroup -[hidden]right-> AdminAuthDtoGroup
ResumeDtoGroup -[hidden]down-> CollectionSendDtoGroup
UserAuthDtoGroup -[hidden]down-> AdminAuthDtoGroup
@enduml
