<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zyh.easyapplyresume.mapper.mysql.ad_monitor.AdmonitorAdminDaliyAdminNumMapper">
    <select id="findFromTimeToEndTimeAdmonitorAdminDaliyAdminNum" resultType="int">
        select adminDaliyAdminNum_num from admonitor_adminDaliyAdminNum
        where adminDaliyAdminNum_date between #{fromDate} and #{endDate}
    </select>
</mapper>