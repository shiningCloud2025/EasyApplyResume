c/pc/common/default_head.png\">\n       </div>\n       <div class=\"name\">\n        <a class=\"autor\" href=\"/\" title=\"锤子简历\">作者：锤子简历</a> <span class=\"date\">2022/10/22</span>\n       </div>\n      </div><span class=\"fenxiang\"> 阅读 175 </span>\n     </div>\n     <div class=\"detail\">\n      <a href=\"https://www.100chui.com/resume/?scode=seo\" title=\"简历模板\"><img src=\"//file.100chui.com/files/upload/image/202409/6cfbcc85-dfd4-4f36-a1b9-3773658d7d2a.jpg\"></a>\n      <p><span style=\"font-size: 16px;margin: 20px 0 10px 0;\n    padding: 3px 8px;\n    border-left: 5px #155bfa solid;\n    background: #f5f7fa;\n    font-size: 20px;\n    font-weight: 600;\n    display: inline-block;\n    border-radius: 0 5px 5px 0; color: rgb(89, 89, 89);\">求职意向</span></p>\n      <table>\n       <tbody>\n        <tr class=\"firstRow\">\n         <td valign=\"top\" rowspan=\"1\" colspan=\"3\" style=\"word-break: break-all;\">岗位：导弹维护技术员</td>\n        </tr>\n        <tr>\n         <td width=\"174\" valign=\"top\" style=\"word-break: break-all;\">城市：广州</td>\n         <td width=\"174\" valign=\"top\" style=\"word-break: break-all;\">薪资：面议</td>\n         <td width=\"174\" valign=\"top\" style=\"word-break: break-all;\">到岗时间：一周内</td>\n        </tr>\n       </tbody>\n      </table>\n      <p><span style=\"font-size: 16px;margin: 20px 0 10px 0;\n    padding: 3px 8px;\n    border-left: 5px #155bfa solid;\n    background: #f5f7fa;\n    font-size: 20px;\n    font-weight: 600;\n    display: inline-block;\n    border-radius: 0 5px 5px 0; color: rgb(89, 89, 89);\">基本信息</span></p>\n      <table width=\"588\">\n       <tbody>\n        <tr class=\"firstRow\">\n         <td width=\"72\" valign=\"top\" style=\"word-break: break-all;\">姓名：锤子简历</td>\n         <td width=\"75\" valign=\"top\" style=\"word-break: break-all;\">出生年月：1996.08.05</td>\n         <td width=\"68\" valign=\"middle\" rowspan=\"4\" colspan=\"1\" style=\"word-break: break-all;\" align=\"center\"><span style=\"text-align: -webkit-center;\">照片</span></td>\n        </tr>\n        <tr>\n         <td width=\"72\" valign=\"top\" style=\"word-break: break-all;\">年龄：25岁</td>\n         <td width=\"75\" valign=\"top\" style=\"word-break: break-all;\">联系电话：13800138000</td>\n        </tr>\n        <tr>\n         <td width=\"72\" valign=\"top\" style=\"word-break: break-all;\">政治面貌：团员</td>\n         <td width=\"75\" valign=\"top\" style=\"word-break: break-all;\">电子邮箱：chuizi@100chui.com</td>\n        </tr>\n        <tr>\n         <td width=\"72\" valign=\"top\" style=\"word-break: break-all;\">籍贯：广东省深圳市</td>\n         <td width=\"75\" valign=\"top\" style=\"word-break: break-all;\">个人网站：<a href=\"http://www.100chui.com/\" target=\"_self\" style=\"white-space: normal;\">www.100chui.com</a></td>\n        </tr>\n       </tbody>\n      </table>\n      <p><span style=\"font-size: 16px;margin: 20px 0 10px 0;\n    padding: 3px 8px;\n    border-left: 5px #155bfa solid;\n    background: #f5f7fa;\n    font-size: 20px;\n    font-weight: 600;\n    display: inline-block;\n    border-radius: 0 5px 5px 0; color: rgb(89, 89, 89);\">教育背景</span></p>\n      <table width=\"588\">\n       <tbody>\n        <tr class=\"firstRow\">\n         <td width=\"108\" valign=\"top\" style=\"word-break: break-all;\">广州大鲸师范大学</td>\n         <td width=\"108\" valign=\"top\" style=\"word-break: break-all;\">2019年09月-2023年06月</td>\n        </tr>\n        <tr>\n         <td width=\"108\" valign=\"top\" style=\"word-break: break-all;\">行政管理</td>\n         <td width=\"108\" valign=\"top\" style=\"word-break: break-all;\">本科学历</td>\n        </tr>\n       </tbody>\n      </table>\n      <p><span style=\"font-size: 16px;margin: 20px 0 10px 0;\n    padding: 3px 8px;\n    border-left: 5px #155bfa solid;\n    background: #f5f7fa;\n    font-size: 20px;\n    font-weight: 600;\n    display: inline-block;\n    border-radius: 0 5px 5px 0; color: rgb(89, 89, 89);\">工作经历</span></p>\n      <table width=\"588\">\n       <tbody>\n        <tr class=\"firstRow\">\n         <td valign=\"top\" rowspan=\"1\" colspan=\"2\" style=\"word-break: break-all;\" width=\"216\"><strong style=\"white-space: normal;\">2022年6月-至今</strong></td>\n        </tr>\n        <tr>\n         <td width=\"106\" valign=\"top\" style=\"word-break: break-all;\"><strong style=\"white-space: normal;\">广州某某信息科技有限公司</strong></td>\n         <td width=\"109\" valign=\"top\" style=\"word-break: break-all;\"><strong style=\"white-space: normal;\">导弹维护技术员</strong></td>\n        </tr>\n        <tr>\n         <td valign=\"top\" colspan=\"2\" rowspan=\"1\" width=\"216\"></td>\n        </tr>\n        <tr>\n         <td valign=\"top\" rowspan=\"1\" colspan=\"2\" style=\"word-break: break-all;\" width=\"216\">\n          <p style=\"margin-top: 0px; margin-bottom: 0px; padding: 0px; white-space: normal;\">导弹维护技术员工作内容描述：</p>\n          <p style=\"margin-top: 0px; margin-bottom: 0px; padding: 0px; white-space: normal;\">● 促进价值13亿美元的民兵III洲际弹道导弹武器系统的日常维护</p>\n          <p style=\"margin-top: 0px; margin-bottom: 0px; padding: 0px; white-space: normal;\">● 对150个民兵发射设施和15个发射控制中心进行常规调度</p>\n          <p style=\"margin-top: 0px; margin-bottom: 0px; padding: 0px; white-space: normal;\">● 为各种设备提供服务，如锅炉旁的高低温制冷系统、冷却器、冷却塔、通风系统以及水源热泵和空气处理器。我也从事工业厨房设备的工作，如蒸锅、烤箱、厨房和其他厨房设备</p>\n          <p style=\"margin-top: 0px; margin-bottom: 0px; padding: 0px; white-space: normal;\">● 检查零件的表面缺陷。</p></td>\n        </tr>\n       </tbody>\n      </table>\n      <p><span style=\"font-size: 16px;margin: 20px 0 10px 0;\n    padding: 3px 8px;\n    border-left: 5px #155bfa solid;\n    background: #f5f7fa;\n    font-size: 20px;\n    font-weight: 600;\n    display: inline-block;\n    border-radius: 0 5px 5px 0; color: rgb(89, 89, 89);\">个人技能</span></p>\n      <table width=\"588\">\n       <tbody>\n        <tr class=\"firstRow\">\n         <td width=\"216\" valign=\"top\" style=\"word-break: break-all;\">技能：Office办公软件，Excel表格、Word文档 \n          <p style=\"margin-top: 0px; margin-bottom: 0px; padding: 0px; font-s