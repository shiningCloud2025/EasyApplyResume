import React from 'react';
import './Resume.css';

// 个人信息组件
const PersonalInfo = () => {
  return (
    <section className="personal-info">
      <h1>张三</h1>
      <p className="title">后端开发工程师 | 5年经验</p>
      <div className="contact">
        <span>📱 138XXXX1234</span>
        <span>📧 zhangsan@example.com</span>
        <span>📍 北京·朝阳区</span>
        <span>🔗 GitHub: github.com/zhangsan</span>
      </div>
    </section>
  );
};

// 技能栈组件
const Skills = () => {
  return (
    <section className="skills">
      <h2 className="section-title">核心技能</h2>
      <div className="skills-grid">
        <div className="skill-item">
          <h3>后端语言</h3>
          <p>Java (精通)、Go (熟练)、Python (掌握)</p>
        </div>
        <div className="skill-item">
          <h3>框架/中间件</h3>
          <p>SpringBoot、SpringCloud、MyBatis、Redis、Kafka、RabbitMQ</p>
        </div>
        <div className="skill-item">
          <h3>数据库</h3>
          <p>MySQL (精通索引优化)、PostgreSQL、MongoDB、Elasticsearch</p>
        </div>
        <div className="skill-item">
          <h3>工程化/运维</h3>
          <p>Docker、K8s、Jenkins、Git、Nginx、Prometheus监控</p>
        </div>
