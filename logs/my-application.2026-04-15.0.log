span style={styles.skill}>合规培训</span>\n          <span style={styles.skill}>风险防控</span>\n        </div>\n      </div>\n    </div>\n  );\n};","industryMapIndustryName":"金融","resumeTemplateIsActive":1,"resumeTemplateCreatedTime":1768147200000,"resumeTemplateUpdatedTime":1768147200000},{"resumeTemplateId":23,"resumeTemplateName":"基金经理助理简历模板","resumeTemplateReactCode":"const ResumeTemplateFundManagerAssistant = () => {\n  const styles = {\n    container: {\n      fontFamily: \"'Microsoft YaHei', sans-serif\",\n      maxWidth: '800px',\n      margin: '0 auto',\n      padding: '40px',\n      background: 'white',\n    },\n    header: {\n      textAlign: 'center',\n      marginBottom: '30px',\n      borderBottom: '2px solid #1890ff',\n      paddingBottom: '20px',\n    },\n    name: {\n      fontSize: '28px',\n      fontWeight: 'bold',\n      color: '#1890ff',\n      marginBottom: '10px',\n    },\n    contact: {\n      fontSize: '14px',\n      color: '#666',\n    },\n    section: {\n      marginBottom: '25px',\n    },\n    sectionTitle: {\n      fontSize: '18px',\n      fontWeight: 'bold',\n      color: '#1890ff',\n      borderLeft: '4px solid #1890ff',\n      paddingLeft: '10px',\n      marginBottom: '15px',\n    },\n    item: {\n      marginBottom: '15px',\n    },\n    itemHeader: {\n      display: 'flex',\n      justifyContent: 'space-between',\n      marginBottom: '5px',\n    },\n    itemTitle: {\n      fontWeight: 'bold',\n      fontSize: '15px',\n    },\n    itemDate: {\n      color: '#999',\n      fontSize: '13px',\n    },\n    itemDesc: {\n      fontSize: '14px',\n      color: '#333',\n      lineHeight: '1.6',\n    },\n    skills: {\n      display: 'flex',\n      flexWrap: 'wrap',\n      gap: '8px',\n    },\n    skill: {\n      background: '#e6f7ff',\n      color: '#1890ff',\n      padding: '4px 12px',\n      borderRadius: '4px',\n      fontSize: '13px',\n    },\n  };\n\n  return (\n    <div style={styles.container}>\n      <div style={styles.header}>\n        <div s