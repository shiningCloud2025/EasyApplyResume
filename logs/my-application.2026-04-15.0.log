={styles.skill}>投资研究</span>\n          <span style={styles.skill}>组合管理</span>\n          <span style={styles.skill}>行业分析</span>\n          <span style={styles.skill}>业绩跟踪</span>\n          <span style={styles.skill}>报告撰写</span>\n          <span style={styles.skill}>CFA L3</span>\n          <span style={styles.skill}>FRM L2</span>\n          <span style={styles.skill}>Wind/Bloomberg</span>\n          <span style={styles.skill}>Excel建模</span>\n        </div>\n      </div>\n    </div>\n  );\n};","industryMapIndustryName":"金融","resumeTemplateIsActive":1,"resumeTemplateCreatedTime":1768147200000,"resumeTemplateUpdatedTime":1768147200000},{"resumeTemplateId":24,"resumeTemplateName":"融资租赁业务经理简历模板","resumeTemplateReactCode":"const ResumeTemplateFinancialLease = () => {\n  const styles = {\n    container: {\n      fontFamily: \"'Microsoft YaHei', sans-serif\",\n      maxWidth: '800px',\n      margin: '0 auto',\n      padding: '40px',\n      background: 'white',\n    },\n    header: {\n      textAlign: 'center',\n      marginBottom: '30px',\n      borderBottom: '2px solid #1890ff',\n      paddingBottom: '20px',\n    },\n    name: {\n      fontSize: '28px',\n      fontWeight: 'bold',\n      color: '#1890ff',\n      marginBottom: '10px',\n    },\n    contact: {\n      fontSize: '14px',\n      color: '#666',\n    },\n    section: {\n      marginBottom: '25px',\n    },\n    sectionTitle: {\n      fontSize: '18px',\n      fontWeight: 'bold',\n      color: '#1890ff',\n      borderLeft: '4px solid #1890ff',\n      paddingLeft: '10px',\n      marginBottom: '15px',\n    },\n    item: {\n      marginBottom: '15px',\n    },\n    itemHeader: {\n      display: 'flex',\n      justifyContent: 'space-between',\n      marginBottom: '5px',\n    },\n    itemTitle: {\n      fontWeight: 'bold',\n      fontSize: '15px',\n    },\n    itemDate: {\n      color: '#999',\n      fontSize: '13px',\n    },\n    itemDesc: {\n      fontSize: '14px',\n      color: '#333',\n      lineHeight: '1.6',\n    },\n 